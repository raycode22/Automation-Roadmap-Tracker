// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  progress      UserProgress[]
  artifacts     Artifact[]
  metrics       Metric[]
  
  @@map("users")
}

model RoadmapWeek {
  id          String       @id @default(cuid())
  weekNumber  Int
  title       String
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Relations
  days        RoadmapDay[]
  
  @@unique([weekNumber])
  @@map("roadmap_weeks")
}

model RoadmapDay {
  id                 String            @id @default(cuid())
  weekId             String
  dayNumber          Int
  title              String
  focusArea          String
  detailedActivities String
  expectedOutput     String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  
  // Relations
  week               RoadmapWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  activities         Activity[]
  artifacts          Artifact[]
  
  @@unique([weekId, dayNumber])
  @@map("roadmap_days")
}

model Activity {
  id          String   @id @default(cuid())
  dayId       String
  title       String
  description String
  toolTags    String   // Comma-separated tags
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  day         RoadmapDay     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  progress    UserProgress[]
  
  @@map("activities")
}

model UserProgress {
  id           String         @id @default(cuid())
  userId       String
  activityId   String
  status       ProgressStatus @default(NOT_STARTED)
  notes        String?        @db.Text
  evidenceUrl  String?
  fileRef      String?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity     Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, activityId])
  @@map("user_progress")
}

model Artifact {
  id          String    @id @default(cuid())
  userId      String
  dayId       String?
  title       String
  description String?
  link        String?
  fileRef     String?
  visibility  String    @default("private") // private or public
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         RoadmapDay? @relation(fields: [dayId], references: [id], onDelete: SetNull)
  
  @@map("artifacts")
}

model Metric {
  id                    String   @id @default(cuid())
  userId                String
  date                  DateTime
  completedCount        Int      @default(0)
  weeklyCompletionPercent Float  @default(0.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@map("metrics")
}